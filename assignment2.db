ormats/><hidden_columns/><plot_y_axes/><global_filter/></table></browse_table_settings></tab_browse><tab_sql><sql name="SQL 1">SELECT 
    (나이 / 10) * 10 || '대' AS 연령대,
    성별,
    SUM(무료 + 기타) AS 무료_잠재고객,
    SUM(골드 + 블루 + 그린) AS 유료_충성고객
FROM Customer
GROUP BY 연령대, 성별;

-- 장르별 분석 (Exhibition 테이블과 JOIN)
SELECT 
    E.장르, 
    COUNT(*) AS 예매건수  -- W.id 대신 COUNT(*)을 사용합니다.
FROM Wheelchair W
JOIN Exhibition E ON W.공연명 = E.제목
GROUP BY E.장르
ORDER BY 예매건수 DESC;

-- 공연장별 분석
SELECT 공간명, COUNT(*) AS 예매건수
FROM Wheelchair
GROUP BY 공간명
ORDER BY 예매건수 DESC;</sql><current_tab id="0"/></tab_sql></sqlb_project>
